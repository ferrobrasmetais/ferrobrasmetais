# ============================================================
# SEGURANÇA DO PAINEL ADMINISTRATIVO
# ============================================================

# Bloquear listagem de diretórios
Options -Indexes

# Forçar HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Proteger arquivos sensíveis
<FilesMatch "\.(log|ini|sql|backup|json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloquear acesso a arquivos de configuração
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>

# Headers de segurança
<IfModule mod_headers.c>
    Header set X-Frame-Options "DENY"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Bloquear acesso por IP (opcional - descomente para ativar)
# Order deny,allow
# Deny from all
# Allow from 192.168.1.0/24  # Substitua pelo seu IP